+  attributes = core::detail::parse_sgr_for_console("32;38;5;196");
+  CHECK(attributes.add == FOREGROUND_GREEN);
+  CHECK(attributes.remove == foreground);
+
+  attributes = core::detail::parse_sgr_for_console("");
+  CHECK(attributes.add == foreground);
+  CHECK(attributes.remove == static_cast<std::uint16_t>(-1));
