+TEST_CASE("diagnostics color options control color stripping")
+{
+  TestContext test_context;
+  REQUIRE(util::write_file("foo.c", ""));
+
+  SUBCASE("always")
+  {
+    Context ctx;
+    ctx.config.set_compiler_type(CompilerType::gcc);
+    ctx.orig_args =
+      Args::from_string("gcc -c foo.c -fdiagnostics-color=always");
+    REQUIRE(process_args(ctx));
+    CHECK_FALSE(ctx.args_info.strip_diagnostics_colors);
+  }
+
+  SUBCASE("never")
+  {
+    Context ctx;
+    ctx.config.set_compiler_type(CompilerType::gcc);
+    ctx.orig_args = Args::from_string("gcc -c foo.c -fdiagnostics-color=never");
+    REQUIRE(process_args(ctx));
+    CHECK(ctx.args_info.strip_diagnostics_colors);
+    CHECK_FALSE(ctx.args_info.translate_diagnostics_colors);
+  }
+}
