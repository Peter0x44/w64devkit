 src/ccache/argsinfo.hpp         |   3 +
 src/ccache/core/common.cpp      | 240 +++++++++++++++++++++++++++++++-
 src/ccache/core/common.hpp      |  21 ++-
 unittest/test_argprocessing.cpp |  26 ++++
 unittest/test_core_common.cpp   |  33 +++++
 6 files changed, 325 insertions(+), 4 deletions(-)

